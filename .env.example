# INSTANCE SETTINGS — the normal deployer-editable configuration.
# INSTANCE_OWNER_NAME is this deployment's display/instance owner; it is not a Developer identity.
INSTANCE_OWNER_NAME=Your Deployment Name
# BOT_NUMBER is the WhatsApp account used to pair and run this bot. Digits only, including country code.
# It is never automatically a Global Owner or Developer identity.
BOT_NUMBER=
# Active visual mode. Theme IDs never replace the GOATVERSE MD master identity or authorization.
THEME=default
# Optional: enables this separately configured number to use instance-owner commands only.
INSTANCE_OWNER_NUMBER=

# Optional instance contact shown by !owner; defaults to https://wa.me/BOT_NUMBER.
OWNER_LINK=
WHATSAPP_CHANNEL=https://whatsapp.com/channel/0029VbBepCNBVJl5vGUHET3T

# PROTECTED SECURITY CONFIGURATION
# Do not set GLOBAL_OWNER_NUMBER, GLOBAL_OWNER_NUMBERS, OWNER_NUMBER, OWNER_NUMBERS,
# DEVELOPER_IDENTITY, or developer-number overrides. These values are rejected at startup.
# Trusted identity manifests and HMAC keys are maintainer-only secrets and must not be put here.

# Bot behaviour
COMMAND_PREFIX=!
STICKER_PACKNAME=𝙂𝙊𝘼𝙏𝙑𝙀𝙍𝙎𝙀 𝙈𝘿
STICKER_AUTHOR=Only F!XA?? Dev
PUBLIC_MODE=true
LOG_LEVEL=info

# WhatsApp authentication
# Use "pairing" for a pairing code or "qr" in an interactive local terminal.
AUTH_METHOD=pairing
# Store this outside Git. For Render/Railway, point it at a mounted persistent volume.
AUTH_DIR=./session

# Runtime data. Premium and group greeting records are stored under DATA_DIR.
DATA_DIR=./data
# PREMIUM_DB_PATH=./data/premium.json
# GROUP_SETTINGS_DB_PATH=./data/groups.json

WELCOME_MESSAGE=Welcome @user to *@group*!
GOODBYE_MESSAGE=Goodbye @user from *@group*.

# Optional AI command. Keep the real API key private and never commit it.
# GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b

RECONNECT_BASE_DELAY_MS=3000
RECONNECT_MAX_DELAY_MS=60000
# BOT_DRY_RUN=false
