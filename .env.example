# Project identity
# Change BOT_NAME here instead of hard-coding it in source files.
BOT_NAME=Black Clover ♣️
OWNER_NAME=Only Fixa Dev
OWNER_NUMBER=923448170040
# Optional comma-separated extra owner numbers; OWNER_NUMBER is always included.
OWNER_NUMBERS=
AUTHOR_NAME=Rashid Hussain
AUTHOR_NUMBER=923448170040
OWNER_LINK=https://wa.me/923448170040
WHATSAPP_CHANNEL=https://whatsapp.com/channel/0029VbBepCNBVJl5vGUHET3T

# Bot behaviour
COMMAND_PREFIX=!
# Optional metadata applied to stickers made with !sticker.
STICKER_PACKNAME=Black Clover ♣️
STICKER_AUTHOR=Only Fixa Dev
PUBLIC_MODE=true
LOG_LEVEL=info

# WhatsApp authentication
# Use "pairing" for a pairing code or "qr" to print a QR code in a local terminal.
AUTH_METHOD=pairing
# Required for non-interactive pairing-code hosts. Digits only, including country code.
# PAIRING_NUMBER=your_linking_phone_number
# Store this outside Git. For Render/Railway, point it at a mounted persistent volume.
AUTH_DIR=./session

# Runtime data. Premium and group greeting records are stored under DATA_DIR.
# Put this on the same persistent volume as AUTH_DIR in production.
DATA_DIR=./data
# PREMIUM_DB_PATH=./data/premium.json
# GROUP_SETTINGS_DB_PATH=./data/groups.json

# Optional group greeting templates. @user and @group are replaced at runtime.
WELCOME_MESSAGE=Welcome @user to *@group*!
GOODBYE_MESSAGE=Goodbye @user from *@group*.

# Optional AI command. Keep the real API key private and never commit it.
# GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b

# Reconnection tuning (milliseconds)
RECONNECT_BASE_DELAY_MS=3000
RECONNECT_MAX_DELAY_MS=60000

# Development/CI only: validates configuration and exits before opening WhatsApp.
# BOT_DRY_RUN=false
