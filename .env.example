# ============================================================================
# USER-FACING CONFIGURATION
# The bot has exactly one owner, so only these two values are required.
# ============================================================================

# Owner display name shown by the dashboard and the !owner command.
OWNER_NAME=Only Fixa Dev

# The WhatsApp number the bot links to.
# Enter your WhatsApp number with country code, without +.
#   Valid:   923001234567
#   Invalid: +923001234567
# There is no country selector: the country code is part of the number.
BOT_NUMBER=923448170040

# SESSION_ID restores a paired session on hosts with ephemeral storage
# (Heroku, Render free tier, panels without a volume, Katabump, Optiklink...).
# Paste the contents of session/creds.json — raw JSON or its base64 form.
# Get it from the dashboard after pairing (set EXPOSE_SESSION_ID=true first),
# or copy session/creds.json from a local pairing.
# It is a full WhatsApp login: never commit it, never share it.
# SESSION_ID=

# ============================================================================
# INTERNAL SETTINGS (optional — safe defaults are built in)
# ============================================================================

# Dashboard / web pairing
# PORT is provided automatically by Heroku, Render and similar hosts.
# PORT=3000
# THEME picks the startup theme: makima, nami, nezuko, shinobu, gojo, sukuna, asta.
THEME=gojo
# Let the dashboard show the SESSION_ID after pairing. Private deployments only.
EXPOSE_SESSION_ID=false
# Overwrite an existing session/creds.json with SESSION_ID on every boot.
SESSION_OVERWRITE=false

# WhatsApp authentication
# The dashboard is web-pairing only and always requests a code for BOT_NUMBER.
# "qr" stays available for local terminal sessions only; it is never shown in the UI.
AUTH_METHOD=pairing
# Store this outside Git. On a panel or VPS with persistent storage keep the
# default; on Heroku/Render pair once locally and ship the SESSION_ID instead.
AUTH_DIR=./session

# Runtime data. Bot mode, premium and group greeting records live under DATA_DIR.
# Put this on the same persistent volume as AUTH_DIR in production.
DATA_DIR=./data
# PREMIUM_DB_PATH=./data/premium.json
# GROUP_SETTINGS_DB_PATH=./data/groups.json
# MODE_DB_PATH=./data/mode.json

# Bot identity and behaviour
BOT_NAME=Black Clover ♣️
COMMAND_PREFIX=!
# Optional metadata applied to stickers made with !sticker.
STICKER_PACKNAME=Black Clover ♣️
STICKER_AUTHOR=Only Fixa Dev
PUBLIC_MODE=true
LOG_LEVEL=info
WHATSAPP_CHANNEL=https://whatsapp.com/channel/0029VbBepCNBVJl5vGUHET3T

# Optional group greeting templates. @user and @group are replaced at runtime.
WELCOME_MESSAGE=Welcome @user to *@group*!
GOODBYE_MESSAGE=Goodbye @user from *@group*.

# Optional AI command. Keep the real API key private and never commit it.
# GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b

# Reconnection tuning (milliseconds)
RECONNECT_BASE_DELAY_MS=3000
RECONNECT_MAX_DELAY_MS=60000

# Development/CI only: validates configuration and exits before opening WhatsApp
# or the dashboard.
# BOT_DRY_RUN=false
