# INSTANCE SETTINGS — safe for each deployment to customize.
# Optional instance label; it never replaces the GOATVERSE MD master name.
BOT_NAME=𝙂𝙊𝘼𝙏𝙑𝙀𝙍𝙎𝙀 𝙈𝘿
INSTANCE_OWNER_NAME=Your Deployment Name
# Optional: grants instance-level owner features only. It never grants Global Owner or Developer access.
INSTANCE_OWNER_NUMBER=
# Legacy display-only alias: BOT_OWNER_NAME=
# Required: the WhatsApp account this deployment will authenticate as. Digits only, including country code.
BOT_CONNECTION_NUMBER=
# Optional active theme ID. A theme is a visual mode only, never the bot identity.
THEME=default
# Optional display link; defaults to https://wa.me/BOT_CONNECTION_NUMBER when left blank.
OWNER_LINK=
WHATSAPP_CHANNEL=https://whatsapp.com/channel/0029VbBepCNBVJl5vGUHET3T

# PROTECTED SECURITY CONFIGURATION
# Global Owner authorization is source-controlled by the security layer. Do not set
# GLOBAL_OWNER_NUMBER, GLOBAL_OWNER_NUMBERS, OWNER_NUMBER, or OWNER_NUMBERS here.
# Attempts to override protected authorization through environment settings fail closed.

# Bot behaviour
COMMAND_PREFIX=!
# Optional metadata applied to stickers made with !sticker.
STICKER_PACKNAME=𝙂𝙊𝘼𝙏𝙑𝙀𝙍𝙎𝙀 𝙈𝘿
STICKER_AUTHOR=Only F!XA?? Dev
PUBLIC_MODE=true
LOG_LEVEL=info

# WhatsApp authentication
# Use "pairing" for a pairing code or "qr" to print a QR code in a local terminal.
AUTH_METHOD=pairing
# Required for non-interactive pairing-code hosts. Digits only, including country code.
# PAIRING_NUMBER=your_linking_phone_number
# Store this outside Git. For Render/Railway, point it at a mounted persistent volume.
AUTH_DIR=./session

# Runtime data. Premium and group greeting records are stored under DATA_DIR.
# Put this on the same persistent volume as AUTH_DIR in production.
DATA_DIR=./data
# PREMIUM_DB_PATH=./data/premium.json
# GROUP_SETTINGS_DB_PATH=./data/groups.json

# Optional group greeting templates. @user and @group are replaced at runtime.
WELCOME_MESSAGE=Welcome @user to *@group*!
GOODBYE_MESSAGE=Goodbye @user from *@group*.

# Optional AI command. Keep the real API key private and never commit it.
# GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b

# Reconnection tuning (milliseconds)
RECONNECT_BASE_DELAY_MS=3000
RECONNECT_MAX_DELAY_MS=60000

# Development/CI only: validates configuration and exits before opening WhatsApp.
# BOT_DRY_RUN=false
