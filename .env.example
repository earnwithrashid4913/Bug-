# ============================================================================
#  ANIME MD — Configuration
#  Copy this file to .env and edit your values.
#  Never commit .env to Git — it can contain secrets.
#
#  QUICK START (sirf 2 values zaroori hain):
#    1. OWNER_NAME apna naam likho
#    2. BOT_NUMBER apna WhatsApp number likho (bina + ke)
#    3. Bot start karo: npm start
# ============================================================================


# ===================== WhatsApp Bot Settings =================================
# In values ko set karna zaroori hai — bot in ke bina kaam nahi karega.

# OWNER_NAME — Apna naam yahan likho
# Dashboard aur !owner command mein yeh naam dikhega
# Example: Rashid Hussain
OWNER_NAME=Rashid Hussain

# BOT_NUMBER — Apna WhatsApp number yahan likho
# Country code ke sath, BINA "+" ke
#   Sahi:   923001234567
#   Galat:  +923001234567
# Bot isi number pe WhatsApp connect hoga
BOT_NUMBER=923448170040


# ===================== Session Restore =======================================
# Agar aap Heroku ya Render (bina disk) pe deploy kar rahe ho toh yeh use karo.
# Apne private host se session/creds.json ka content yahan paste karo.
# Raw JSON ya base64 dono chalega.
# Yeh ek full WhatsApp login hai — kabhi commit ya share mat karna.
# SESSION_ID=


# ===================== Bot Appearance ========================================

# BOT_NAME — Bot ka display name (logs, commands, dashboard)
# Default: ANIME MD
# BOT_NAME=ANIME MD

# THEME — Dashboard ka startup theme
# Options: makima, nami, nezuko, shinobu, gojo, sukuna, asta
# Khali chhodne pe user ko theme choose karna padega
THEME=gojo

# COMMAND_PREFIX — Commands ka prefix (1-4 characters, bina space ke)
# Default: !
# COMMAND_PREFIX=!


# ===================== Bot Mode ==============================================

# PUBLIC_MODE — Sabko commands use karne do ya sirf owner ko
# true  = sab use kar sakte hain (groups mein bhi)
# false = sirf owner use kar sakta hai
PUBLIC_MODE=true


# ===================== WhatsApp Authentication ===============================

# AUTH_METHOD — WhatsApp kaise connect hoga
# pairing = Web Pairing dashboard (recommended, default)
# qr      = Terminal QR code (sirf local CLI ke liye)
AUTH_METHOD=pairing

# AUTH_DIR — WhatsApp credentials kahan save honge
# Is folder ko private aur persistent rakhao
# Render pe: /var/data/session
# Heroku pe: SESSION_ID use karo (yeh folder hamesha wipe hota hai)
AUTH_DIR=./session

# SESSION_OVERWRITE — Kya har boot pe SESSION_ID se existing session overwrite karein?
# true  = hamesha overwrite karo (sirf agar SESSION_ID use kar rahe ho)
# false = agar session already hai toh skip karo (default)
SESSION_OVERWRITE=false


# ===================== Data Storage ==========================================

# DATA_DIR — Bot ka data kahan save hoga (mode, premium, groups, etc.)
# Is folder ko AUTH_DIR ke sath same persistent volume pe rakhao
# Render pe: /var/data/data
DATA_DIR=./data

# Neeche ke paths auto-set hote hain DATA_DIR se. Sirf tab change karo jab
# aapko custom path chahiye.
# PREMIUM_DB_PATH=./data/premium.json
# GROUP_SETTINGS_DB_PATH=./data/groups.json
# MODE_DB_PATH=./data/mode.json
# SUDO_DB_PATH=./data/sudo.json
# WARNING_DB_PATH=./data/warnings.json
# ECONOMY_DB_PATH=./data/economy.json
# RUNTIME_SETTINGS_DB_PATH=./data/settings.json
# AUTOMATION_DB_PATH=./data/automation.json


# ===================== Sticker Settings ======================================

# !sticker command se banaye gaye stickers pe yeh naam dikhega
# STICKER_PACKNAME=ANIME MD
# STICKER_AUTHOR=F!xa Dev


# ===================== Group Greetings ========================================

# Welcome/Goodbye messages. @user aur @group runtime pe replace hote hain.
# WELCOME_MESSAGE=Welcome @user to *@group*!
# GOODBYE_MESSAGE=Goodbye @user from *@group*.


# ===================== WhatsApp Channel ======================================

# Apna WhatsApp channel link yahan do (optional)
# !owner command mein dikhega
WHATSAPP_CHANNEL=https://whatsapp.com/channel/0029VbBepCNBVJl5vGUHET3T


# ===================== Connection Images =====================================

# Jab WhatsApp successfully connect ho, yeh image bheji jayegi
CONNECTION_SUCCESS_IMAGE=https://files.catbox.moe/6ghm7j.png


# ===================== AI Command (!ai) ======================================

# Groq AI API key — !ai command ke liye optional hai
# https://console.groq.com se free key lo
# GROQ_API_KEY=gsk_xxxxxxxxxxxxxxxxxxxxxxxx

# Groq model — default theek hai, change mat karo agar zaroorat na ho
GROQ_MODEL=openai/gpt-oss-20b


# ===================== Media Downloader ======================================

# Cobalt API — YouTube, TikTok, Instagram downloads ke liye
# Default server chal raha hai, change mat karo agar kaam kar raha hai
COBALT_API_URL=https://cobalt-api.kwiatekmiki.com

# Catbox upload API — !tourl command ke liye
UPLOAD_API_URL=https://catbox.moe/user/api.php


# ===================== Telegram Controller ===================================
# Telegram se bot ko remotely control karne ke liye (pairing, status, etc.)
# Dono (TELEGRAM_BOT_TOKEN + TELEGRAM_OWNER_IDS) set karna zaroori hai.

# Telegram Bot Token — @BotFather se mila token yahan paste karo
# Example: 7123456789:AAHxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Yeh secret hai — kabhi commit ya share mat karna
# TELEGRAM_BOT_TOKEN=

# Telegram Bot Link — Apne bot ka t.me link
# Example: https://t.me/YourAnimeMdBot
# TELEGRAM_BOT_LINK=https://t.me/your_bot

# Telegram Owner IDs — Apni numeric Telegram User ID yahan enter karo
# Multiple IDs comma se alag karo
# Apni ID jaanne ke liye Telegram pe @userinfobot ko message karo
# Example: 123456789
# TELEGRAM_OWNER_IDS=123456789

# Telegram controller database (auto-set hota hai DATA_DIR se)
# TELEGRAM_CONTROLLER_DB_PATH=./data/telegram-controllers.json

# Telegram controller images
TELEGRAM_START_IMAGE=https://files.catbox.moe/cvdoo3.png
TELEGRAM_CONNECTED_IMAGE=https://files.catbox.moe/uuuqdm.png


# ===================== Reconnection ==========================================

# WhatsApp disconnect hone pe kitni der baad retry karein (milliseconds)
# Default values theek hain — sirf tab change karo jab zaroorat ho
# RECONNECT_BASE_DELAY_MS=3000
# RECONNECT_MAX_DELAY_MS=60000


# ===================== Dashboard / Web Server =================================

# PORT — Dashboard ka port. Heroku/Render automatically set karte hain.
# PORT=3000

# WEB_HOST — Dashboard kis address pe sune
# 0.0.0.0 = sab IPs pe (default, production ke liye)
# WEB_HOST=0.0.0.0


# ===================== Logging ===============================================

# LOG_LEVEL — Kitna detail logs mein dikhe
# Options: fatal, error, warn, info (default), debug, trace, silent
LOG_LEVEL=info


# ===================== Development Only ======================================

# BOT_DRY_RUN — Sirf config validate karo, WhatsApp connect mat karo
# Testing ke liye useful: npm run start:dry
# BOT_DRY_RUN=false
